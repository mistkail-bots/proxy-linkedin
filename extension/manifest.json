{
  "manifest_version": 3,
  "name": "LinkedIn US Proxy",
  "version": "1.2.0",
  "description": "Routes only LinkedIn traffic through your own US proxy server and blocks LinkedIn if the proxy goes down.",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider",
    "declarativeNetRequest",
    "alarms",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn US Proxy"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js"
      ],
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.licdn.com/*"
      ]
    }
  ]
}
